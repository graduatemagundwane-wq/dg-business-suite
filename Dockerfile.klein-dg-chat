FROM node:22-bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends unzip ca-certificates && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY klein-manasseh/chat-source.b64 /tmp/chat-source.b64
RUN base64 -d /tmp/chat-source.b64 > /tmp/chat-source.zip \
 && unzip -q /tmp/chat-source.zip -d /app \
 && rm -f /tmp/chat-source.b64 /tmp/chat-source.zip \
 && test -f /app/server.js \
 && node --check /app/server.js
ENV PORT=10000
EXPOSE 10000
CMD ["node","server.js"]
